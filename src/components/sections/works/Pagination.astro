---
// components
import Link from "../../elements/Link.astro";
import "../../../styles/components/sections.css";

// i18n
import { getLang, dict } from "../../../i18n/utils";

const lang = getLang(Astro.url.pathname);
const tr = dict(lang);

// props
type Props = {
    prev?: string;
    next?: string;
}

const { prev, next } = Astro.props;
---

<div class="pagination">
    {
        prev && (
            <Link variant={'button'} href={prev}>{tr.common.previous}</Link>
        )
    }
    {
        next && (
            <Link variant={'button'} href={next}>{tr.common.next}</Link>
        )
    }
</div>
