---
// components
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
import Link from "../../elements/Link.astro";
import ImageContainer from "../../elements/ImageContainer.astro";
import "../../../styles/components/sections-home.css";

// i18n
import { getLang, dict, localizePath } from "../../../i18n/utils";

const lang = getLang(Astro.url.pathname);
const tr = dict(lang);

// assets
import daniel2 from "../../../assets/images/daniel2.webp";
---

<Container variant={'xl'}>
    <Heading tagName="h2" tagSize="h2" class="heading--center heading--acknowledgement">{tr.home.about.heading}</Heading>
    <div class="about__columns">
        <div class="about__content">
            <Text variant={'xl'}>{tr.home.about.p1}</Text>
            <Text variant={'sm'}>{tr.home.about.p2}</Text>
            <Text variant={'sm'}>{tr.home.about.p3}</Text>
            <Link variant={'button'} href={localizePath(lang, "/about")}>{tr.common.moreAboutMe}</Link>
        </div>
        <div class="about__media">
            <ImageContainer src={daniel2} alt={tr.home.about.imageAlt} />
        </div>
    </div>
</Container>
