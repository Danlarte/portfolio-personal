---
// components
import Link from "../elements/Link.astro";
import LangSwitcher from "../elements/LangSwitcher.astro";
import "../../styles/components/navigation.css";

// i18n
import { getLang, dict, localizePath } from "../../i18n/utils";

const lang = getLang(Astro.url.pathname);
const tr = dict(lang);

// links
const navLinks = [
    { key: "home", path: "/" },
    { key: "works", path: "/works" },
    { key: "about", path: "/about" },
    { key: "contact", path: "/contact" }
] as const;
---

<nav class="nav" role="navigation" aria-label="Main navigation">
    <!-- Desktop Nav -->
    <ul class="nav__list">
        {
            navLinks.map((link) => (
                <li>
                    <Link href={localizePath(lang, link.path)} variant={'nav'}>{tr.nav[link.key]}</Link>
                </li>
            ))
        }
    </ul>
    <LangSwitcher />
    <!-- Mobile Nav -->
    <div class="nav__toggle-wrap">
        <button class="nav__toggle" id="open-nav" aria-label={tr.nav.openNav} aria-expanded="false" aria-controls="mobile-nav">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"><path fill="#ffffff" d="m9.5 16.5l7-4.5l-7-4.5v9ZM12 22q-2.075 0-3.9-.788t-3.175-2.137q-1.35-1.35-2.137-3.175T2 12q0-2.075.788-3.9t2.137-3.175q1.35 1.35 3.175-2.137T12 2q2.075 0 3.9.788t3.175 2.137q1.35 1.35 2.138 3.175T22 12q0 2.075-.788 3.9t-2.137 3.175q-1.35 1.35-3.175 2.138T12 22Zm0-2q3.35 0 5.675-2.325T20 12q0-3.35-2.325-5.675T12 4Q8.65 4 6.325 6.325T4 12q0 3.35 2.325 5.675T12 20Zm0-8Z"/></svg>
        </button>
        <div class="nav__mobile" id="mobile-nav" role="dialog" aria-modal="true" aria-label={tr.nav.openNav}>
            <div class="nav__mobile-inner">
                <button id="close-nav" class="nav__close" aria-label={tr.nav.closeNav}>
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24"><path fill="#ffffff" d="M9 16h2V8H9v8Zm4 0h2V8h-2v8Zm-1 6q-2.075 0-3.9-.788t-3.175-2.137q-1.35-1.35-2.137-3.175T2 12q0-2.075.788-3.9t2.137-3.175q1.35 1.35 3.175-2.137T12 2q2.075 0 3.9.788t3.175 2.137q1.35 1.35 2.138 3.175T22 12q0 2.075-.788 3.9t-2.137 3.175q-1.35 1.35-3.175 2.138T12 22Zm0-2q3.35 0 5.675-2.325T20 12q0-3.35-2.325-5.675T12 4Q8.65 4 6.325 6.325T4 12q0 3.35 2.325 5.675T12 20Zm0-8Z"/></svg>
                </button>
                <ul class="nav__mobile-list">
                    {
                        navLinks.map((link) => (
                            <li><Link href={localizePath(lang, link.path)} variant={'nav'} data-nav-link>{tr.nav[link.key]}</Link></li>
                        ))
                    }
                </ul>
                <LangSwitcher class="nav__mobile-lang" />
            </div>
        </div>
    </div>
</nav>

<script>
    const nav = document.querySelector('.nav');
    const openBtn = document.querySelector('#open-nav') as HTMLButtonElement;
    const closeBtn = document.querySelector('#close-nav') as HTMLButtonElement;
    const mobileNav = document.querySelector('#mobile-nav') as HTMLElement;
    const mobileLinks = mobileNav?.querySelectorAll('[data-nav-link]') || [];

    let lastFocusedElement: HTMLElement | null = null;

    const openMenu = () => {
        lastFocusedElement = document.activeElement as HTMLElement;
        nav?.classList.add('nav--open');
        openBtn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        // Focus first focusable element in mobile menu
        setTimeout(() => {
            const firstFocusable = mobileNav?.querySelector('button, a') as HTMLElement;
            firstFocusable?.focus();
        }, 100);
    };

    const closeMenu = () => {
        nav?.classList.remove('nav--open');
        openBtn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        lastFocusedElement?.focus();
    };

    openBtn.addEventListener("click", openMenu);
    closeBtn.addEventListener("click", closeMenu);

    // Close menu when clicking a link
    mobileLinks.forEach(link => {
        link.addEventListener("click", closeMenu);
    });

    // Close menu on Escape key
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && nav?.classList.contains("nav--open")) {
            closeMenu();
        }
    });

    // Trap focus in mobile menu
    mobileNav?.addEventListener("keydown", (e) => {
        if (e.key === "Tab" && nav?.classList.contains("nav--open")) {
            const focusableElements = mobileNav.querySelectorAll('button, a');
            const firstElement = focusableElements[0] as HTMLElement;
            const lastElement = focusableElements[focusableElements.length - 1] as HTMLElement;

            if (e.shiftKey && document.activeElement === firstElement) {
                e.preventDefault();
                lastElement.focus();
            } else if (!e.shiftKey && document.activeElement === lastElement) {
                e.preventDefault();
                firstElement.focus();
            }
        }
    });

    // Close menu on outside click
    mobileNav?.addEventListener("click", (e) => {
        if (e.target === mobileNav) {
            closeMenu();
        }
    });

    // auto-hide: oculta el nav al bajar el scroll, lo muestra al subir
    let lastY = window.scrollY;
    let ticking = false;

    const TOP_THRESHOLD = 80; // px — se ignora el movimiento pegado al tope
    const SCROLL_THRESHOLD = 50; // px — para activar el estado scrolled

    const onScroll = () => {
        const y = window.scrollY;
        if (!nav?.classList.contains('nav--open')) {
            if (y > lastY && y > TOP_THRESHOLD) {
                nav?.classList.add('nav--hidden');
            } else if (y < lastY) {
                nav?.classList.remove('nav--hidden');
            }
        }
        // Toggle scrolled state for background
        if (y > SCROLL_THRESHOLD) {
            nav?.classList.add('nav--scrolled');
        } else {
            nav?.classList.remove('nav--scrolled');
        }
        lastY = y;
    };

    window.addEventListener('scroll', () => {
        if (!ticking) {
            window.requestAnimationFrame(() => {
                onScroll();
                ticking = false;
            });
            ticking = true;
        }
    }, { passive: true });

    // Initial check for scrolled state
    if (window.scrollY > SCROLL_THRESHOLD) {
        nav?.classList.add('nav--scrolled');
    }

    // Handle resize: close mobile menu if resized to desktop
    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768 && nav?.classList.contains('nav--open')) {
            closeMenu();
        }
    });
</script>
