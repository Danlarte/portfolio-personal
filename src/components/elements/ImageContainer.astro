---
// assets
import { Image } from "astro:assets";
import barCode from "../../assets/ui/barcode.svg";
import "../../styles/components/image-container.css";

const { src, alt } = Astro.props;
---
<div class="image-container">
    <Image src={barCode} alt="Bar Code" loading="eager"/>
    <div class="image-container__frame">
        <Image
            src={src}
            alt={alt}
            loading="eager"
            class="image-container__img"
            widths={[300, 450, 700, 1100, src.width]}
            sizes={`(max-width: 320px) 300px, (max-width: 480px) 450px,(max-width: 768px) 700px, (max-width: 1200px) 1100px, ${src.width}px`}
            />
    </div>
</div>
