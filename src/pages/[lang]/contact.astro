---
// layout
import Layout from "../../layouts/Layout.astro"

// components
import Intro from "../../components/sections/contact/Intro.astro"
import ContactDetails from "../../components/sections/contact/ContactDetails.astro"

// i18n
import { LOCALES, getLang, dict } from "../../i18n/utils";

export function getStaticPaths() {
    return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLang(Astro.url.pathname);
const tr = dict(lang);
---

<Layout
    lang={lang}
    title={tr.contact.meta.title}
    description={tr.contact.meta.description}
>
    <Intro />
    <ContactDetails />
</Layout>
