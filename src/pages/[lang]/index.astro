---
// layout
import Layout from '../../layouts/Layout.astro';

// components
import Hero from '../../components/sections/home/Hero.astro';
import SelectedWorks from '../../components/sections/home/SelectedWorks.astro';
import Services from '../../components/sections/home/Services.astro';
import About from '../../components/sections/home/About.astro';
import Faq from '../../components/sections/home/Faq.astro';

// i18n
import { LOCALES, getLang, dict } from '../../i18n/utils';

export function getStaticPaths() {
    return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = getLang(Astro.url.pathname);
const tr = dict(lang);
---

<Layout
    lang={lang}
    title={tr.home.meta.title}
    description={tr.home.meta.description}
>
    <Hero />
    <SelectedWorks />
    <Services />
    <About />
    <Faq />
</Layout>
