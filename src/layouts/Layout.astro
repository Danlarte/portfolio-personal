---
// stylesheet
import "../styles/global.css";

// components
import BaseHead from "../components/global/BaseHead.astro";
import Wrapper from "../components/global/Wrapper.astro";
import NavBar from "../components/global/Navigation.astro";
import Footer from "../components/global/Footer.astro";

// i18n
import { DEFAULT_LANG, LOCALE_META, type Lang } from "../i18n/utils";

// assets
import bg from "../assets/images/bg-1.webp";
import { getImage } from "astro:assets";
const backgroundImage = await getImage({src: bg, format:'jpg'})

// props
const {title, description, titleTemplate, siteName, ogImage, twitterSite, themeColor, lang = DEFAULT_LANG, locale, ...seoProps } = Astro.props;
const ogLocale = locale ?? LOCALE_META[lang as Lang].ogLocale;
---

<!doctype html>
<html lang={LOCALE_META[lang as Lang].htmlLang}>
	<BaseHead
		title={title}
      	description={description}
      	titleTemplate={titleTemplate}
    	siteName={siteName}
      	ogImage={ogImage}
      	twitterSite={twitterSite}
      	themeColor={themeColor}
      	locale={ogLocale}
      	{...seoProps}
	/>
	<body style=`background-image: url(${backgroundImage.src})`>
		<!-- Background noise effect -->
		<div class="noise"></div>
		<!-- Wrapper component to make sure all content on the website is above the noise filter background -->
		<Wrapper>
			<NavBar />
			<main class="layout__main">
				<slot />
			</main>
			<Footer />
		</Wrapper>
		<script is:inline>
			document.cookie = "lang=" + document.documentElement.lang + ";path=/;max-age=31536000;samesite=lax";
		</script>
	</body>
</html>
